
# Minimal OpenWrt firewall config. Zone/forwarding rules are
# allow LAN->WAN through fw4 so it does not override the separate vendo5
# MAC gate. An accept in one nft base chain is still subject to every other
# base chain: unpaid clients remain blocked by vendo5's forward DROP policy.
# Runtime allow/revoke operations populate that table's MAC set.

config defaults
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'DROP'
	option synflood_protect '1'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'lan'

config zone
	option name 'wan'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'wan'
	option masq '0'

config include 'vendo5'
	option type 'nftables'
	option path '/etc/vendo5-firewall.nft'
	# a table of its own: fw4 would otherwise paste the file INSIDE its own table, which is a syntax error that stops the whole firewall
	option position 'ruleset-append'

# fw4 and vendo5 both run on the forward hook; both must allow paid traffic.
config forwarding 'vendo5_lan_wan'
	option src 'lan'
	option dest 'wan'
