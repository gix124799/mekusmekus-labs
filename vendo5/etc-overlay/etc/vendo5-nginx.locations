# Captive redirect: a DNAT'd request still carries the site the client asked for as Host; send it to the portal's own address.
set $cp "";
if ($server_addr = 10.0.0.1) { set $cp 1; }
if ($host = 10.0.0.1) { set $cp ""; }
if ($cp) { return 302 http://10.0.0.1/; }

location / {
	client_max_body_size 210m;
	limit_conn perip 10;
	limit_req zone=ip burst=30 delay=8;
	proxy_pass http://127.0.0.1:3000;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_buffering off;
}
