# vendo5 firewall ruleset — creates the table/set/chains that
# lib/firewall.js's runtime `nft add/delete element` and `nft flush set`
# calls assume already exist. Loaded via /etc/config/firewall's
# `config include` (see etc-overlay/etc/config/firewall), reloaded
# whenever the OpenWrt firewall itself reloads.
#
# Policy: a client's MAC in `allowed` gets full internet (forward +
# masquerade). Everyone else: plain HTTP (port 80) to ANY destination is
# redirected to the portal, regardless of which site they were trying to
# reach (standard pisowifi/captive-portal technique — works without any
# DNS hijacking, so paid clients' real DNS resolution is untouched).
# Everything else for an unpaid client (HTTPS, other ports/protocols) is
# dropped — there is no way to show a portal page over HTTPS without a
# client-trusted certificate, which is out of scope; this is the same
# limitation every captive portal has. Modern OSes auto-detect this via a
# plain-HTTP connectivity-check URL and pop the "sign in to network"
# browser on their own.
#
# The WAN port name is detected at boot (etc/vendo5-netdetect.sh), see the define below.
#
# Syntax validated with `sudo nft -c -f` against a real nft binary
# (2026-10-10) — clean, no errors. Not yet run against a real device's
# actual interfaces (that still needs on-hardware testing).

# The WAN port's name. etc/vendo5-netdetect.sh rewrites this one line at boot if the real WAN port is not eth0;
# every rule below (and lib/system/shaper.js, which reads it) follows it. Rules stay pinned to that one port.
define WAN = "eth0"

# Declare the base chains before flushing so first boot and subsequent fw4
# reloads use the same atomic transaction. Preserve allowed/walled sets and
# dynamic bwlimit rules; replace only static rules to remove stale WAN names.
table inet vendo5 {
    chain dstnat {
        type nat hook prerouting priority dstnat; policy accept;
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
    }
}
flush chain inet vendo5 dstnat
flush chain inet vendo5 forward
flush chain inet vendo5 postrouting

table inet vendo5 {
	set allowed {
		type ether_addr
	}

	# Walled garden: destinations an unpaid client may reach (the admin's Utility page fills this set).
	set walled {
		type ipv4_addr
	}

	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "br-lan" ip daddr @walled accept
		# unpaid clients: DNS to the captive resolver (dnsmasq 'captive', port 90), web to the portal's nginx
		iifname "br-lan" ether saddr != @allowed udp dport 53 redirect to :90
		iifname "br-lan" ether saddr != @allowed tcp dport 53 redirect to :90
		iifname "br-lan" ether saddr != @allowed tcp dport 80 dnat ip to 10.0.0.1:80
		# HTTPS is NOT DNAT'd here (see header comment): forcing it to nginx's self-signed cert on an
		# SNI/Host it doesn't own fails TLS before the browser ever sees our redirect, so the phone shows
		# "can't be reached" instead of the portal. Falls through to the forward chain's DROP policy
		# instead — confirmed fix, tested on real hardware 2026-10-13 (TEST_vendo5_v11_portal-fixed-v3).
	}

	# Per-device speed limits and byte counters; lib/system/shaper.js rewrites this chain (flush + rules) as one
	# `nft -f` transaction. Runs just before the forward chain's accept rules.
	chain bwlimit {
		type filter hook forward priority filter - 1; policy accept;
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		# Only WAN replies bypass the client-MAC check. LAN traffic must still
		# match the live allowed/walled sets, including established TCP flows.
		iifname $WAN oifname "br-lan" ct state established,related accept
		iifname "br-lan" oifname $WAN ether saddr @allowed accept
		iifname "br-lan" oifname $WAN ip daddr @walled accept
		# unpaid traffic to the portal's own HTTP proxy (port 80) and to the
		# router itself must still reach it — only gate LAN->WAN forwarding.
		iifname "br-lan" oifname "br-lan" accept
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname $WAN ether saddr @allowed masquerade
	}
}
