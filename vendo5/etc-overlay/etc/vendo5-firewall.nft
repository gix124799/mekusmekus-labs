# vendo5 firewall ruleset — creates the table/set/chains that
# lib/firewall.js's runtime `nft add/delete element` and `nft flush set`
# calls assume already exist. Loaded via /etc/config/firewall's
# `config include` (see etc-overlay/etc/config/firewall), reloaded
# whenever the OpenWrt firewall itself reloads.
#
# Policy: a client's MAC in `allowed` gets full internet (forward +
# masquerade). Everyone else: plain HTTP (port 80) to ANY destination is
# redirected to the portal, regardless of which site they were trying to
# reach (standard pisowifi/captive-portal technique — works without any
# DNS hijacking, so paid clients' real DNS resolution is untouched).
# Everything else for an unpaid client (HTTPS, other ports/protocols) is
# dropped — there is no way to show a portal page over HTTPS without a
# client-trusted certificate, which is out of scope; this is the same
# limitation every captive portal has. Modern OSes auto-detect this via a
# plain-HTTP connectivity-check URL and pop the "sign in to network"
# browser on their own.
#
# shortcut: "eth0" (WAN) below is a best-guess interface name, matching
# etc/config/network — not yet confirmed on real hardware (the owner
# doesn't know the USB-to-LAN adapter's exact chipset, though that
# adapter's own port only needs to be correct in config/network, since
# it's bridged into "br-lan" there and this file only ever refers to
# "br-lan"). If "eth0" is wrong on the real device, it's a one-line fix
# here and in config/network. Verify with `ip link` after boot.
#
# Syntax validated with `sudo nft -c -f` against a real nft binary
# (2026-10-10) — clean, no errors. Not yet run against a real device's
# actual interfaces (that still needs on-hardware testing).

table inet vendo5 {
	set allowed {
		type ether_addr
	}

	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "br-lan" ether saddr != @allowed tcp dport 80 dnat ip to 10.0.0.1:3000
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "br-lan" oifname "eth0" ether saddr @allowed accept
		# unpaid traffic to the portal's own app (port 3000) and to the
		# router itself must still reach it — only gate LAN->WAN forwarding.
		iifname "br-lan" oifname "br-lan" accept
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" ether saddr @allowed masquerade
	}
}
