
config main 'global'
	option uci_enable 'true'

config server '_lan'
	list listen '443 ssl default_server'
	list listen '10.0.0.1:80'
	option server_name '_lan'
	option uci_manage_ssl 'self-signed'
	option ssl_certificate '/etc/nginx/conf.d/_lan.crt'
	option ssl_certificate_key '/etc/nginx/conf.d/_lan.key'
	option ssl_session_cache 'shared:SSL:32k'
	option ssl_session_timeout '64m'
	list include 'restrict_locally'
	list include '/soft/config/nginx.locations'
	option client_body_buffer_size     '32k'
	option client_header_buffer_size   '8k'
	option large_client_header_buffers '8 64k'

config server '_subvendo'
	list listen '4455 ssl default_server'
	option server_name '_subvendo'
	list include 'restrict_locally'
	list include '/soft/config/subvendo.locations'
	option uci_manage_ssl 'self-signed'
	option ssl_certificate '/etc/nginx/conf.d/_lan.crt'
	option ssl_certificate_key '/etc/nginx/conf.d/_lan.key'
	option ssl_session_cache 'shared:SSL:32k'
	option ssl_session_timeout '64m'

config server 'redirect_ngrok'
	list listen '127.0.0.1:8080'
	option server_name '_ngrok'
	list include '/soft/config/admin.locations'

config server 'redirect_pppoe'
	list listen '11.0.0.1:80'
	option server_name '_pppoe'
	list include '/soft/config/pppoe.locations'

config server 'media_server'
	list listen '10.0.0.1:4400'
	option server_name '_media'
	list include '/soft/config/media.locations'

