+++ b/vendo5/test/boot-leds.test.js
@@ -0,0 +1,26 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const script = path.resolve(__dirname, '../etc-overlay/lib/preinit/80_vendo5_leds');
+function run(root) {
+  return spawnSync('sh', ['-c', 'boot_hook_add() { "$2"; }; . "$1"', 'test', script], {
+    env: { ...process.env, VENDO5_LED_ROOT: root }, encoding: 'utf8'
+  });
+}
+test('early boot enables the power LED and status heartbeat using the board LED devices', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'v5-leds-'));
+  try {
+    for (const name of ['orangepi:green:pwr', 'orangepi:red:status']) {
+      fs.mkdirSync(path.join(root, name)); fs.writeFileSync(path.join(root, name, 'trigger'), 'none\n');
+    }
+    assert.equal(run(root).status, 0);
+    assert.equal(fs.readFileSync(path.join(root, 'orangepi:green:pwr/trigger'), 'utf8'), 'default-on\n');
+    assert.equal(fs.readFileSync(path.join(root, 'orangepi:red:status/trigger'), 'utf8'), 'heartbeat\n');
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+test('absent LED hardware does not abort preinit', () => {
+  assert.equal(run('/nonexistent/vendo5-leds').status, 0);
+});
diff --git a/vendo5/etc-overlay/lib/preinit/80_vendo5_leds b/vendo5/etc-overlay/lib/preinit/80_vendo5_leds
new file mode 100644
index 0000000..516b198
--- /dev/null
+++ b/vendo5/etc-overlay/lib/preinit/80_vendo5_leds
@@ -0,0 +1,14 @@
+#!/bin/sh
+# Orange Pi One kernel LED names, verified against the original DTB/runtime.
+# A missing LED must never block boot. This runs before application startup.
+vendo5_boot_leds() {
+    local root=${VENDO5_LED_ROOT:-/sys/class/leds}
+    if [ -e "$root/orangepi:green:pwr/trigger" ]; then
+        echo default-on > "$root/orangepi:green:pwr/trigger" 2>/dev/null || true
+    fi
+    if [ -e "$root/orangepi:red:status/trigger" ]; then
+        echo heartbeat > "$root/orangepi:red:status/trigger" 2>/dev/null || true
+    fi
+    return 0
+}
+boot_hook_add preinit_main vendo5_boot_leds
diff --git a/vendo5/etc-overlay/etc/uci-defaults/90-vendo5-leds b/vendo5/etc-overlay/etc/uci-defaults/90-vendo5-leds
new file mode 100644
