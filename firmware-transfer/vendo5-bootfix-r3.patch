diff --git a/vendo5/scripts/verify-image.py b/vendo5/scripts/verify-image.py
new file mode 100644
index 0000000..905eb46
--- /dev/null
+++ b/vendo5/scripts/verify-image.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Read-only release gate: original boot bytes plus exact shipped app/config files."""
+import argparse, hashlib, json, pathlib, struct, subprocess, tempfile, zlib
+
+def digest(data): return hashlib.sha256(data).hexdigest()
+def fat_files(part):
+    bps=struct.unpack_from('<H',part,11)[0];spc=part[13]
+    reserved=struct.unpack_from('<H',part,14)[0];nf=part[16]
+    roots=struct.unpack_from('<H',part,17)[0];spf=struct.unpack_from('<H',part,22)[0]
+    root=(reserved+nf*spf)*bps;data=root+((roots*32+bps-1)//bps)*bps
+    result={}
+    for i in range(roots):
+        e=part[root+32*i:root+32*(i+1)]
+        if not e[0]:break
+        if e[0]==229 or e[11]==15 or e[11]&24:continue
+        name=e[:8].decode().strip();ext=e[8:11].decode().strip()
+        name=name+('.'+ext if ext else '')
+        c=struct.unpack_from('<H',e,26)[0];size=struct.unpack_from('<I',e,28)[0];out=b'';seen=set()
+        while 2<=c<65528:
+            assert c not in seen,'FAT cluster loop';seen.add(c)
+            out+=part[data+(c-2)*spc*bps:data+(c-1)*spc*bps]
+            c=struct.unpack_from('<H',part,reserved*bps+c*2)[0]
+        assert len(out)>=size,'truncated FAT file'
+        result[name]=out[:size]
+    return result
+
+def legacy_image(blob,kind):
+    header=blob[:64];assert len(header)==64
+    fields=struct.unpack('>7I4B32s',header)
+    assert fields[0]==0x27051956,'bad U-Boot magic'
+    assert fields[1]==zlib.crc32(header[:4]+b'\0'*4+header[8:])&0xffffffff,'bad header CRC'
+    assert len(blob)==64+fields[3],'bad U-Boot payload size'
+    assert fields[6]==zlib.crc32(blob[64:])&0xffffffff,'bad payload CRC'
+    assert fields[9]==kind,'wrong U-Boot image type'
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('base');ap.add_argument('candidate');args=ap.parse_args()
+    base=pathlib.Path(args.base);candidate=pathlib.Path(args.candidate)
+    assert base.stat().st_size==candidate.stat().st_size,'image size changed'
+    with base.open('rb') as bf,candidate.open('rb') as cf:
+        bm=bf.read(512);cm=cf.read(512);assert bm==cm and cm[510:]==b'\x55\xaa','MBR mismatch'
+        parts=[struct.unpack_from('<II',cm,446+i*16+8) for i in range(4)]
+        bootstart,bootlen=parts[0];rootstart,rootlen=parts[1]
+        assert rootstart*512==69206016,'unexpected root offset'
+        rootend=(rootstart+rootlen)*512
+        bf.seek(0);cf.seek(0);before=cf.read(rootstart*512)
+        assert before==bf.read(rootstart*512),'bootloader/boot partition changed'
+        bf.seek(rootend);cf.seek(rootend);assert bf.read()==cf.read(),'source trailer changed'
+        cf.seek(bootstart*512);fat=fat_files(cf.read(bootlen*512))
+    for name,kind in [('BOOT.SCR',6),('UIMAGE',2)]:legacy_image(fat[name],kind)
+    assert fat['DTB'][:4]==b'\xd0\x0d\xfe\xed' and b'xunlong,orangepi-one\0' in fat['DTB'],'wrong board DTB'
+    assert b'root=PARTUUID=${uuid}' in fat['BOOT.SCR'],'boot root reference changed'
+    offset=f'{candidate}?offset={rootstart*512}'
+    subprocess.run(['e2fsck','-fn',offset],check=True)
+    with tempfile.TemporaryDirectory(prefix='vendo5-image-verify-') as tmp:
+        def dump(image,src,dest):
+            result=subprocess.run(['debugfs','-R',f'dump {src} {dest}',f'{image}?offset={rootstart*512}'],capture_output=True,text=True)
+            assert pathlib.Path(dest).is_file(),f'missing {src}: {result.stderr}'
+        for i,src in enumerate(['/sbin/init','/sbin/procd','/usr/bin/node','/etc/shadow','/etc/inittab','/etc/rc.common','/etc/init.d/boot','/etc/init.d/led','/etc/config/system']):
+            a=pathlib.Path(tmp)/f'base-{i}';b=pathlib.Path(tmp)/f'candidate-{i}'
+            dump(base,src,a);dump(candidate,src,b);assert a.read_bytes()==b.read_bytes(),f'protected file changed: {src}'
+        subprocess.run(['debugfs','-R',f'rdump /opt/vendo5 {tmp}',offset],check=True,capture_output=True)
+        entries=json.loads(subprocess.check_output(['node','-e',"console.log(JSON.stringify(require('./scripts/image-commands').entriesFor(process.cwd())))"],text=True))
+        for item in entries:
+            actual=pathlib.Path(tmp)/item['dest'].removeprefix('/opt/')
+            assert actual.is_file() and actual.read_bytes()==pathlib.Path(item['src']).read_bytes(),f'bad shipped file: {item["dest"]}'
+        for src,imagepath in [('etc/init.d/vendo5','/etc/init.d/vendo5'),('etc-overlay/etc/vendo5-netdetect.sh','/etc/vendo5-netdetect.sh'),('etc-overlay/etc/vendo5-firewall.nft','/etc/vendo5-firewall.nft'),('etc-overlay/etc/init.d/firewall','/etc/init.d/firewall'),('etc-overlay/lib/preinit/80_vendo5_leds','/lib/preinit/80_vendo5_leds'),('etc-overlay/etc/uci-defaults/90-vendo5-leds','/etc/uci-defaults/90-vendo5-leds')]+[(f'etc-overlay/etc/config/{n}',f'/etc/config/{n}') for n in ['network','dhcp','firewall']]:
+            target=pathlib.Path(tmp)/'config-check';target.unlink(missing_ok=True);dump(candidate,imagepath,target)
+            assert target.read_bytes()==pathlib.Path(src).read_bytes(),f'bad config: {imagepath}'
+        service=subprocess.check_output(['debugfs','-R','stat /etc/init.d/vendo5',offset],stderr=subprocess.DEVNULL,text=True)
+        assert '0755' in service,'service not executable'
+        rc=subprocess.check_output(['debugfs','-R','stat /etc/rc.d/S95vendo5',offset],stderr=subprocess.DEVNULL,text=True)
+        assert '../init.d/vendo5' in rc,'missing autostart'
+    print(json.dumps({'status':'PASS','shipped_files':len(entries),'boot_region_sha256':digest(before),'image_bytes':candidate.stat().st_size,'hardware_boot':'NOT YET VERIFIED'},indent=2))
+if __name__=='__main__':main()
diff --git a/vendo5/scripts/firewall-integration-netns-test.sh b/vendo5/scripts/firewall-integration-netns-test.sh
new file mode 100644
index 0000000..eceed2d
--- /dev/null
+++ b/vendo5/scripts/firewall-integration-netns-test.sh
@@ -0,0 +1,92 @@
+#!/bin/bash
+# Real-kernel check of the bandwidth limits, no hardware needed: a private network namespace (unprivileged) with a
+# fake LAN client and WAN host, the real vendo5 nft ruleset, and the shaper. Prints a 3 MB download unlimited, then
+# with an 8 Mbit/s (1 MB/s) limit, and the byte counters.   Run: unshare -Urn bash scripts/shaper-netns-test.sh
+set -e
+trap 'kill ${CP:-} ${WP:-} $(jobs -p) 2>/dev/null; true' EXIT
+R=$(cd "$(dirname "$0")/.." && pwd); J=$(mktemp -d)
+ip link set lo up
+unshare -n sleep 600 >/dev/null 2>&1 & CP=$!
+unshare -n sleep 600 >/dev/null 2>&1 & WP=$!
+sleep 0.5
+ip link add br-lan type veth peer name c0; ip link set c0 netns $CP
+ip link add eth0 type veth peer name w0; ip link set w0 netns $WP
+ip addr add 10.0.0.1/24 dev br-lan; ip link set br-lan up
+ip addr add 10.9.0.1/24 dev eth0; ip link set eth0 up
+nsenter -t $CP -n sh -c "ip link set c0 address aa:bb:cc:dd:ee:01; ip addr add 10.0.0.5/24 dev c0; ip link set c0 up; ip link set lo up; ip route add default via 10.0.0.1"
+nsenter -t $WP -n sh -c "ip addr add 10.9.0.2/24 dev w0; ip link set w0 up; ip link set lo up; ip route add default via 10.9.0.1"
+sysctl -qw net.ipv4.ip_forward=1
+# Reproduce the second forward base chain generated by OpenWrt fw4.
+# Its effective LAN->WAN verdict follows the shipped UCI config; the MAC
+# gate in the separate vendo5 table must still enforce unpaid/revoked clients.
+python3 - "$R/etc-overlay/etc/config/firewall" "$J/fw4.nft" <<'FW4'
+import sys,re,pathlib
+config=pathlib.Path(sys.argv[1]).read_text()
+blocks=re.split(r'^config ', config, flags=re.M)
+defaults=next(b for b in blocks if b.startswith('defaults'))
+policy=re.search(r"option forward '([^']+)'",defaults)[1].lower()
+allow=any(b.startswith('forwarding') and "option src 'lan'" in b and "option dest 'wan'" in b for b in blocks)
+rules='ct state established,related accept;'
+if allow: rules+=' iifname "br-lan" oifname "eth0" accept;'
+pathlib.Path(sys.argv[2]).write_text('table inet fw4 { chain forward { type filter hook forward priority filter; policy '+policy+'; '+rules+' }\n}\n')
+FW4
+nft -f "$J/fw4.nft"
+nft -f $R/etc-overlay/etc/vendo5-firewall.nft
+nft add element inet vendo5 allowed '{ aa:bb:cc:dd:ee:01 }'
+head -c 3000000 /dev/zero > $J/blob
+(cd $J && nsenter -t $WP -n python3 -m http.server 8088 >/dev/null 2>&1 &) ; sleep 1
+ping -c1 -W1 10.0.0.5 >/dev/null || true
+echo "--- no limit"
+nsenter -t $CP -n python3 - <<PY
+import time,urllib.request
+t=time.time(); n=len(urllib.request.urlopen('http://10.9.0.2:8088/blob',timeout=30).read()); print('download', n, 'bytes in %.1fs'%(time.time()-t))
+PY
+# An already-established TCP flow must stop when its MAC is revoked.
+nsenter -t $WP -n python3 -u - <<'SERVER' >/dev/null 2>&1 &
+import socket
+s=socket.socket();s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1);s.bind(('10.9.0.2',9999));s.listen()
+c,_=s.accept()
+while True:
+ data=c.recv(1024)
+ if not data:break
+ c.sendall(data)
+SERVER
+sleep 0.5
+ROUTER_PID=$$
+nsenter -t $CP -n python3 - "$ROUTER_PID" <<'ESTABLISHED'
+import socket,subprocess,sys
+s=socket.create_connection(('10.9.0.2',9999),timeout=2)
+s.sendall(b'before');assert s.recv(1024)==b'before'
+subprocess.run(['nsenter','-t',sys.argv[1],'-n','nft','delete','element','inet','vendo5','allowed','{ aa:bb:cc:dd:ee:01 }'],check=True)
+s.sendall(b'after')
+try:
+ data=s.recv(1024)
+ assert not data, 'FAIL: revoked client still uses an established TCP connection'
+except socket.timeout:
+ print('PASS: revocation also blocks established TCP traffic')
+finally:
+ s.close()
+ subprocess.run(['nsenter','-t',sys.argv[1],'-n','nft','add','element','inet','vendo5','allowed','{ aa:bb:cc:dd:ee:01 }'],check=True)
+ESTABLISHED
+
+echo "--- with 8M download limit (1,000,000 B/s)"
+node -e "
+const {execFileSync}=require('child_process');const {createShaper}=require('$R/lib/system/shaper');
+const A='aa:bb:cc:dd:ee:01';const sess={[A]:{expiresAt:Date.now()+9e5,upload:'8M',download:'8M',max_data_limit:'1M'}};
+global.sh=createShaper({runCommand:(a)=>execFileSync(a[0],a.slice(1),{encoding:'utf8'}),sessions:{all:()=>sess,getSession:(m)=>sess[m]},arp:{neighbors:()=>({[A]:{ip:'10.0.0.5'}})},file:'$J/e2e-limits.nft',onCap:(m)=>console.log('CAP reached for',m)});
+sh.tick();
+"
+nsenter -t $CP -n python3 - <<PY
+import time,urllib.request
+t=time.time(); n=len(urllib.request.urlopen('http://10.9.0.2:8088/blob',timeout=60).read()); print('download', n, 'bytes in %.1fs'%(time.time()-t))
+PY
+echo "--- after revoke (not allowed): the same download must fail"
+nft delete element inet vendo5 allowed '{ aa:bb:cc:dd:ee:01 }'
+nsenter -t $CP -n python3 - <<PY
+import urllib.request
+try:
+    urllib.request.urlopen('http://10.9.0.2:8088/blob', timeout=3).read(); print('FAIL: revoked client still got through')
+except Exception as e:
+    print('PASS: revoked client blocked (%s)' % type(e).__name__)
+PY
+nft list chain inet vendo5 bwlimit | grep -o 'comment.*\|bytes [0-9]*' | head -6
