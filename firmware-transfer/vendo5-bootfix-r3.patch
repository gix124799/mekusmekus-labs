--- /dev/null
+++ b/vendo5/etc-overlay/etc/uci-defaults/90-vendo5-leds
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Keep preinit's visible boot indication when the OpenWrt LED service starts.
+[ -d /sys/class/leds/orangepi:green:pwr ] || exit 0
+uci -q get system.vendo5_power >/dev/null || {
+    uci set system.vendo5_power=led
+    uci set system.vendo5_power.name='Power'
+    uci set system.vendo5_power.sysfs='orangepi:green:pwr'
+    uci set system.vendo5_power.trigger='default-on'
+    uci set system.vendo5_power.default='1'
+}
+uci -q get system.vendo5_status >/dev/null || {
+    uci set system.vendo5_status=led
+    uci set system.vendo5_status.name='System heartbeat'
+    uci set system.vendo5_status.sysfs='orangepi:red:status'
+    uci set system.vendo5_status.trigger='heartbeat'
+    uci set system.vendo5_status.default='1'
+}
+uci commit system
